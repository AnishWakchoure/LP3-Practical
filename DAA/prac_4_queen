#include <iostream>
using namespace std;

int n, board[20][20];

bool isSafe(int row, int col)
{
    for (int i = 0; i < row; i++)
    {
        if (board[i][col] == 1)
            return false;

        if (col - (row - i) >= 0 &&
            board[i][col - (row - i)] == 1)
            return false;

        if (col + (row - i) < n &&
            board[i][col + (row - i)] == 1)
            return false;
    }

    return true;
}

bool solve(int row)
{
    if (row == n)
        return true;

    for (int col = 0; col < n; col++)
    {
        if (isSafe(row, col))
        {
            board[row][col] = 1;

            if (solve(row + 1))
                return true;

            board[row][col] = 0;  // Backtracking
        }
    }

    return false;
}

int main()
{
    cout << "Enter N: ";
    cin >> n;

    board[0][0] = 1;  // First queen fixed

    if (solve(1))
    {
        cout << "Final N-Queens Matrix:\n";

        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < n; j++)
                cout << board[i][j] << " ";

            cout << endl;
        }
    }
    else
    {
        cout << "No solution exists";
    }

    return 0;
}
